{
  "name": "book-notes",
  "version": "1.0.0",
  "description": "A simple book notes application for an end-to-end DevOps portfolio.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --watch index.js --watch db.js --watch services --watch views --watch public index.js",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 test/unit/*.test.js test/integration/*.test.js",
    "test:container": "docker compose -f compose.test.yml up --abort-on-container-exit --exit-code-from tests",
    "test:container:down": "docker compose -f compose.test.yml down --volumes",
    "docker:build": "docker build --tag book-notes:local .",
    "compose:up": "docker compose up --build --detach",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs --follow"
  },
  "keywords": [
    "express",
    "postgresql",
    "devops"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
