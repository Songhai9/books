<%- include("partials/header.ejs") %>

<section class="form-page wide" style="--reader-color: <%= reader.color %>">
  <p class="eyebrow" style="color: var(--reader-color)"><%= reader.name %>'s library</p>
  <h1>Add a book</h1>

  <form class="isbn-form" action="/books/new" method="get">
    <input type="hidden" name="reader" value="<%= reader.id %>">
    <label for="isbn">ISBN-10 or ISBN-13</label>
    <div class="inline-fields">
      <input
        id="isbn"
        name="isbn"
        type="text"
        value="<%= values.isbn %>"
        maxlength="20"
        placeholder="9780735211292"
        required
        autofocus
      >
      <button class="button" type="submit">Look up book</button>
    </div>
    <p class="field-help">Spaces and hyphens are accepted.</p>
  </form>

  <% if (lookupMessage) { %>
    <p class="form-notice" role="status"><%= lookupMessage %></p>
  <% } %>

  <% if (formError) { %>
    <p class="form-error" role="alert"><%= formError %></p>
  <% } %>

  <% if (lookupAttempted) { %>
    <form class="book-form" action="/books" method="post">
      <input type="hidden" name="readerId" value="<%= reader.id %>">
      <input type="hidden" name="isbn" value="<%= values.isbn %>">
      <input type="hidden" name="coverUrl" value="<%= values.coverUrl %>">

      <% if (values.coverUrl) { %>
        <div class="lookup-cover">
          <img src="<%= values.coverUrl %>" alt="Cover returned for <%= values.title || 'this ISBN' %>">
        </div>
      <% } %>

      <div class="book-fields">
        <label for="title">Title</label>
        <input id="title" name="title" type="text" maxlength="200" value="<%= values.title %>" required>

        <label for="author">Author</label>
        <input id="author" name="author" type="text" maxlength="150" value="<%= values.author %>" required>

        <div class="split-fields">
          <div>
            <label for="rating">Rating out of 10</label>
            <input id="rating" name="rating" type="number" min="1" max="10" value="<%= values.rating %>" required>
          </div>
          <div>
            <label for="dateRead">Date read</label>
            <input id="dateRead" name="dateRead" type="date" value="<%= values.dateRead %>" required>
          </div>
        </div>

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="8" required><%= values.notes %></textarea>

        <div class="form-actions">
          <button class="button" type="submit">Add to <%= reader.name %>'s library</button>
          <a class="text-link" href="/?reader=<%= reader.id %>">Cancel</a>
        </div>
      </div>
    </form>
  <% } else { %>
    <p><a class="text-link" href="/?reader=<%= reader.id %>">Return to <%= reader.name %>'s library</a></p>
  <% } %>
</section>

<%- include("partials/footer.ejs") %>
